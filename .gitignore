# Build output and local data
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Toolchain + downloaded dependencies (generated by python tool/fetch_deps.py)
.tools/

# Native prebuilt dependencies (see docs/build.md)
native/third_party/
native/build/
app/android/.cxx/
app/android/app/.cxx/

# Windows desktop build tree and the artifacts Flutter/CMake regenerate.
# Without these two lines `git add .` tries to commit a multi-hundred-MB
# CMake/MSBuild tree and the push fails.
app/windows/out/
app/windows/flutter/ephemeral/
app/windows/runner/Debug/
app/windows/runner/Release/
app/windows/x64/
# Visual Studio's CMake integration (see docs/build.md 6.5): if someone does
# enable it, it writes out/ and CMakeSettings.json at the repo root.
out/
CMakeSettings.json
*.pdb
*.ilk
*.exp
*.lib
*.obj

# Xcode / Gradle
# 注意：Runner.xcworkspace 是 flutter create 生成的、必须保留的工程文件，
# 所以这里不能再写笼统的 *.xcworkspace（那样会把它一起忽略掉）。
# 只忽略 CocoaPods 自己的产物与 Xcode 的本地状态。
app/ios/Pods/
app/macos/Pods/
app/ios/.symlinks/
app/macos/.symlinks/
app/ios/Flutter/ephemeral/
app/macos/Flutter/ephemeral/
app/ios/Flutter/Generated.xcconfig
app/macos/Flutter/ephemeral/Flutter-Generated.xcconfig
**/xcuserdata/
**/DerivedData/
android/.gradle/
app/android/app/build/

# Editors
.idea/
.vscode/
.vs/
*.iml
.DS_Store

# Local debug notes
build/acl-recovery/
