<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>LanPlayer</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>lanplayer</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Module 5: expose the app documents folder in Files.app so local files
	     can be dropped in without a file picker plugin. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- SMB connections go out to the local network. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>LanPlayer 需要访问局域网，才能连接你家里的 SMB 共享并播放视频。</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_smb._tcp</string>
	</array>

	<!-- Audio keeps playing when the screen locks. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- iOS 26 SDK 起，未采用 UIScene 生命周期的 app 会在启动时命中
	     _UIApplicationEvaluateRuntimeIssueForNoSceneLifecycleAdoption 的
	     EXC_BREAKPOINT。这里声明单 scene 并把窗口交给 SceneDelegate 创建
	     （见 Runner/AppDelegate.swift）。 -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- iPad 上 `SystemChrome.setPreferredOrientations` 默认不生效：支持 Slide
	     Over / Split View 的 app 由系统分配窗口，程序无权把窗口转成横的
	     （Flutter 文档原话是 "This setting will only be respected on iPad if
	     multitasking is disabled"）。这一项在老系统上仍然能让 Dart 侧那次调用
	     生效，所以留着；但 iPadOS 26 起所有 app 都跑在可调整大小的窗口里，这一项
	     已被系统忽略（实测：加上它之后仍报 Main display orientation: portrait），
	     真正让播放页转横的是宿主自己的几何请求，见 Runner/AppDelegate.swift 的
	     `requestOrientation(landscape:)`。iPhone 上此键无副作用。 -->
	<key>UIRequiresFullScreen</key>
	<true/>
</dict>
</plist>
